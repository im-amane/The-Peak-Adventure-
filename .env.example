BOT_TOKEN=123456:replace_with_your_bot_token
DATABASE_PATH=peak_adventure.db
# Optional: set DATABASE_URL to opt into PostgreSQL. If set, startup fails closed on connection/schema errors.
# DATABASE_URL=postgresql://user:password@host:5432/database
LOG_LEVEL=INFO
WEBAPP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=

# SQLite snapshots: first backup on startup, then every 6 hours
BACKUP_DIR=backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION=7


# Telegram Stars premium purchases stay disabled until the owner enables them.
ENABLE_TELEGRAM_STARS=false
PREMIUM_SPARK_STARS=25
PREMIUM_CREST_STARS=50
PREMIUM_CROWN_STARS=100

# PostgreSQL logical backup defaults (install pg_dump and pg_restore separately)
POSTGRES_BACKUP_DIR=postgres_backups
POSTGRES_BACKUP_RETENTION=7
