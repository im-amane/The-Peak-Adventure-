BOT_TOKEN=123456:replace_with_your_bot_token
DATABASE_PATH=peak_adventure.db
LOG_LEVEL=INFO
WEBAPP_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=

# SQLite snapshots: first backup on startup, then every 6 hours
BACKUP_DIR=backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION=7
