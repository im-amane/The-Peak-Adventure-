{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peak-adventure-edge",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./webapp",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/healthz"
    ]
  }
}
